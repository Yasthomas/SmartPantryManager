<?xml version="1.0" encoding="utf-8"?>
<!-- One recipe row: name plus either the availability summary or the missing ingredient. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp"
    tools:context=".ui.SuggestedRecipesActivity">

    <TextView
        android:id="@+id/recipe_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Garlic Butter Pasta" />

    <TextView
        android:id="@+id/recipe_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/muted_text"
        android:textSize="14sp"
        tools:text="3 ingredients — all available" />
</LinearLayout>
